{
  "name": "amberkeeper",
  "private": true,
  "version": "0.1.11",
  "description": "Local-first Electron workspace for capturing and managing conversations across mainstream AI providers.",
  "author": "JS-banana <oooooohoney@163.com>",
  "license": "MIT",
  "homepage": "https://github.com/JS-banana/amberkeeper",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JS-banana/amberkeeper.git"
  },
  "bugs": {
    "url": "https://github.com/JS-banana/amberkeeper/issues"
  },
  "type": "module",
  "scripts": {
    "desktop:dev": "pnpm --dir apps/desktop dev",
    "desktop:test": "pnpm --dir apps/desktop test",
    "desktop:build": "pnpm --dir apps/desktop build",
    "desktop:icons": "pnpm --dir apps/desktop icons",
    "desktop:dist:dir": "pnpm --dir apps/desktop run dist:dir",
    "desktop:dist": "pnpm --dir apps/desktop dist",
    "desktop:dist:mac": "pnpm --dir apps/desktop dist:mac",
    "desktop:dist:win": "pnpm --dir apps/desktop dist:win",
    "desktop:release:hygiene:repo": "pnpm --dir apps/desktop run release:hygiene:repo",
    "desktop:release:hygiene": "pnpm --dir apps/desktop run release:hygiene",
    "desktop:gemini:dry-run": "pnpm --dir apps/desktop gemini:dirty-data:dry-run",
    "desktop:gemini:cleanup": "pnpm --dir apps/desktop gemini:dirty-data:cleanup"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
